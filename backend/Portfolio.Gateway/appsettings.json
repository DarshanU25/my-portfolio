{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "webapi-route": {
        "ClusterId": "webapi-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "webapi-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5100"
          }
        }
      }
    }
  }
}
